<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <IsTrimmable>true</IsTrimmable>
    <RootNamespace>MinigrafSharp</RootNamespace>

    <PackageId>MinigrafSharp</PackageId>
    <Version>0.1.0-preview.5</Version>
    <Title>MinigrafSharp</Title>
    <Description>An independent .NET binding for Minigraf using the official minigraf-c API.</Description>
    <PackageProjectUrl>https://github.com/jenolaszlo-sketch/minigraf-sharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/jenolaszlo-sketch/minigraf-sharp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>minigraf;graph;database;datalog;temporal;native</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Packaging is opt-in: pass -p:MinigrafSharpEnablePack=true. Without it
         the project is not packable by design, so ordinary builds and tests
         never produce a package. -->
    <IsPackable Condition="'$(MinigrafSharpEnablePack)' != 'true'">false</IsPackable>
    <IsPackable Condition="'$(MinigrafSharpEnablePack)' == 'true'">true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Pack="true" PackagePath="/" />
    <None Include="../../NOTICE" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Native runtime assets: the exact staged files qualification tested on
       each OS, placed at runtimes/<rid>/native/ so NuGet deploys them
       normally. The CI dist job stages each RID on its own runner and uploads
       it; the pack job downloads them here. The pack-time target below fails
       if any qualified RID asset is missing, so a partial package cannot be
       produced silently. To add a RID: qualify it by execution on its own
       runner, add its <None> item and the requirement below, then update
       eng/Verify-NativeStaging.ps1, eng/Verify-Package.ps1, and
       docs/packaging.md. -->
  <ItemGroup>
    <None Include="../../native/staging/win-x64/minigraf.dll"
          Condition="Exists('../../native/staging/win-x64/minigraf.dll')"
          Pack="true"
          PackagePath="runtimes/win-x64/native/" />
    <None Include="../../native/staging/linux-x64/libminigraf.so"
          Condition="Exists('../../native/staging/linux-x64/libminigraf.so')"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/" />
    <None Include="../../native/staging/osx-arm64/libminigraf.dylib"
          Condition="Exists('../../native/staging/osx-arm64/libminigraf.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/" />
    <None Include="../../native/staging/win-x64/minigrafsharp_shim.dll"
          Condition="Exists('../../native/staging/win-x64/minigrafsharp_shim.dll')"
          Pack="true"
          PackagePath="runtimes/win-x64/native/" />
    <None Include="../../native/staging/linux-x64/libminigrafsharp_shim.so"
          Condition="Exists('../../native/staging/linux-x64/libminigrafsharp_shim.so')"
          Pack="true"
          PackagePath="runtimes/linux-x64/native/" />
    <None Include="../../native/staging/osx-arm64/libminigrafsharp_shim.dylib"
          Condition="Exists('../../native/staging/osx-arm64/libminigrafsharp_shim.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native/" />
  </ItemGroup>

  <Target Name="MinigrafSharpRequireNativeAssetsForPack"
          BeforeTargets="GenerateNuspec"
          Condition="'$(MinigrafSharpEnablePack)' == 'true'">
    <Error Condition="!Exists('../../native/staging/win-x64/minigraf.dll') Or !Exists('../../native/staging/linux-x64/libminigraf.so') Or !Exists('../../native/staging/osx-arm64/libminigraf.dylib') Or !Exists('../../native/staging/win-x64/minigrafsharp_shim.dll') Or !Exists('../../native/staging/linux-x64/libminigrafsharp_shim.so') Or !Exists('../../native/staging/osx-arm64/libminigrafsharp_shim.dylib')"
           Text="All qualified native assets (official engine + owned shim per RID) must be staged before packing: native/staging/{win-x64/minigraf.dll, linux-x64/libminigraf.so, osx-arm64/libminigraf.dylib, win-x64/minigrafsharp_shim.dll, linux-x64/libminigrafsharp_shim.so, osx-arm64/libminigrafsharp_shim.dylib}. Stage them with eng/Get-Native.ps1 + eng/Build-Shim.ps1 or the CI dist job." />
  </Target>
</Project>
