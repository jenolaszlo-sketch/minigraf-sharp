<Project Sdk="Microsoft.NET.Sdk">
  <!-- NativeAOT smoke for the packaged MinigrafSharp. References the
       generated NuGet package, never a ProjectReference. Build/run it with
       eng/Test-AotConsumer.ps1, which supplies the local package feed and an
       isolated cache and runs it outside the repository. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MinigrafSharp" Version="0.1.0-preview.2" />
  </ItemGroup>
</Project>
